{
  "name": "compony-dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "公司多智能体协同系统 DSH 插件：部门/HR/会议室/敏捷/看板/Git/问题库/审计，带前端面板",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./src/web/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
