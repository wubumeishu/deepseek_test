{
  "name": "compony",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "公司多智能体协同系统（DSH 插件 + 前端面板）",
  "scripts": {
    "dev": "vite",
    "build": "tsdown dsh-plugin",
    "build:panel": "vite build",
    "serve:panel": "node static-server.mjs",
    "check:render": "node scripts/render-check.mjs",
    "verify:panel": "npm run build:panel && npm run check:render",
    "test": "vitest run",
    "smoke": "node --experimental-strip-types engine-smoke.mjs",
    "start:api": "node --experimental-strip-types apps/server/src/index.ts",
    "lint": "eslint src --no-warn-ignored",
    "test:full": "npm run lint && npm run test && npm run smoke"
  },
  "dependencies": {
    "@compony/engine": "workspace:*",
    "@compony/protocol": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^10.12.0",
    "jsdom": "^24.1.0",
    "pnpm": "^12.9.1",
    "tsdown": "^0.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}